# One agent process. Persona/model/pace all arrive via environment.
FROM python:3.12-slim
RUN pip install --no-cache-dir requests && useradd -m -u 1000 swarm
COPY agents/ /app/agents/
USER swarm
WORKDIR /app/agents
# Gold chassis resolve `from utils.X` / `from providers.Y` against the
# shared agents/lib via PYTHONPATH (per-folder consolidation, ticket
# c530b5af) -- set here so every agent service inherits it regardless of
# which per-folder working_dir/entrypoint a service overrides it with.
ENV PYTHONPATH=/app/agents/lib
ENTRYPOINT ["python3", "Experimental.py"]
