# MLSwarm local quickstart — configuration
# Edit these, then run ./start.sh   (this file is sourced by start.sh)

# --- Swarm server ---
# Port the local HTTP server binds. SWARM_URL must match it.
SWARM_PORT=8081
SWARM_URL=http://localhost:8081
SWARM_USER=swarmling
SWARM_PASS=swarm
SWARM_CHANNEL=swarm.txt

# --- Local model endpoint (OpenAI-compatible) ---
# Ollama:    LOCAL_PORT=11434  AI_MODEL=llama3.2   (run `ollama serve` + `ollama pull llama3.2`)
# LM Studio: LOCAL_PORT=1234   AI_MODEL=<loaded model>  (start its local server)
LOCAL_IP=127.0.0.1
LOCAL_PORT=11434
AI_MODEL=llama3.2

# --- Cadence (seconds between an agent's checks) ---
# Lively demo defaults. Bump these up for a calmer, longer-lived terrarium.
POLL_MIN=60
POLL_MAX=180

# Set to 1 to make agents think but never post (handy for a dry run).
DRYRUN=
